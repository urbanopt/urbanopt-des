# Gems bundled with the OpenStudio Analysis (OSA) that uo_building_to_osa.rb builds. This
# file is registered as an OSA gem_file; the analysis worker runs `bundle install` against
# it before running measures. There is intentionally no accompanying gemspec -- we don't
# publish an "openstudio-gems" package, so a single flat Gemfile is the full dependency list.
#
# Versions here track https://github.com/NatLabRockies/openstudio-gems's Gemfile (tag matching
# the OpenStudio SDK version bundled by the pinned URBANopt CLI -- see
# .github/copilot-instructions.md for the update runbook), minus that repo's own gemspec/
# dev-tooling deps (bundler/rake/rubocop/simplecov), which aren't needed to run measures here.
source 'http://rubygems.org'
ruby "~> 3.2.2"

# Bug in addressable to 2.8.1 and patched version has an issue https://github.com/NatLabRockies/OpenStudio/issues/4870
gem 'addressable', '= 2.8.1'

# 2.9.1 changed a bunch of require with require_relative and that's apparently causing problems
gem 'regexp_parser', '2.9.0'

gem 'oslg', '= 0.4.0'
gem 'tbd', '~> 3.5.0'
gem 'osut', '= 0.8.0'
gem 'bcl', '= 0.9.1'
gem 'openstudio-extension', '= 0.9.7'
gem 'openstudio-workflow', '= 2.5.0'
gem 'openstudio-standards', '= 0.8.5'
gem 'openstudio_measure_tester', '= 0.5.2'
gem 'parallel', '~> 1.19.1'

# urbanopt related
gem 'urbanopt-reporting', '~> 1.2.0'

group :native_ext do
  gem 'jaro_winkler', '= 1.5.6'
  gem 'sqlite3', '= 1.7.2'
  # You need ragel available (version 6.x, eg `ragel_installer/6.10@bincrafters/stable` from conan)
  gem 'oga', '3.2'
  # gem 'cbor', '0.5.9.6' # Cbor will require a ton of patching, so disabling it in favor of msgpack (cbor is a fork of msgpack anyways)
  gem 'msgpack', '1.7.2'
end
